{
  "name": "ilovemusic-streamdeck",
  "version": "0.1.0",
  "description": "Stream Deck plugin that controls the ILOVEMusic macOS menubar app.",
  "type": "module",
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "watch": "rolldown -c rolldown.config.ts -w",
    "typecheck": "tsc --noEmit",
    "test": "rolldown -c rolldown.tests.config.ts && node .test-dist/run.js",
    "version:sync": "node Scripts/version.mjs",
    "version:check": "node Scripts/version.mjs --check",
    "package": "./Scripts/package.sh"
  },
  "devDependencies": {
    "@elgato/cli": "^1.7.1",
    "@tsconfig/node20": "^20.1.2",
    "@types/node": "^20.19.0",
    "rolldown": "^1.0.0-rc.6",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.0.0",
    "@elgato/utils": "^0.4.5"
  }
}
